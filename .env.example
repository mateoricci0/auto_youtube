# ============================================================
# AUTO YOUTUBE — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- DEEPSEEK ---
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat          # V3 — fast, cheap, production
DEEPSEEK_R1_MODEL=deepseek-reasoner   # R1 — strategic decisions only

# --- YOUTUBE DATA API ---
# Create a project at: https://console.cloud.google.com
# Enable "YouTube Data API v3", then create an API Key under Credentials.
YOUTUBE_API_KEY=your-youtube-api-key-here

# --- TTS PROVIDER (choose ONE) ---
# Option A: gTTS — GRATIS, sin tarjeta, sin registro (recomendado para empezar)
#   No necesita ninguna configuración adicional.
TTS_PROVIDER=gtts

# Option B: Google Cloud TTS Neural2 — mejor calidad, gratis hasta 1M chars/mes
#   Requiere cuenta de facturación en Google Cloud (no cobra si no superas el free tier).
#   1. Enable "Cloud Text-to-Speech API" en Google Cloud
#   2. Crea una Service Account, descarga el JSON
#   3. Guárdalo como config/google_credentials.json
# TTS_PROVIDER=google
# GOOGLE_APPLICATION_CREDENTIALS=config/google_credentials.json

# Option C: OpenAI TTS — ~$1.50/mes para este volumen, muy buena calidad
# TTS_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=onyx   # options: alloy, echo, fable, onyx, nova, shimmer

# --- PEXELS (stock footage) ---
# Free API key at: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# --- NOTIFICACIONES POR EMAIL (opcional pero muy recomendado) ---
# Recibirás un email cuando se publique un vídeo o si hay un error.
# Usa tu cuenta Gmail con una "Contraseña de aplicación":
#   1. myaccount.google.com → Seguridad → Verificación en 2 pasos (actívala)
#   2. myaccount.google.com → Seguridad → Contraseñas de aplicaciones
#   3. Crea una para "TechHoy Bot" → copia los 16 caracteres sin espacios
NOTIFY_EMAIL_FROM=tu@gmail.com
NOTIFY_EMAIL_TO=tu@gmail.com
NOTIFY_EMAIL_PASSWORD=abcdefghijklmnop

# --- SYSTEM ---
OUTPUT_DIR=output
LOGS_DIR=logs
