# ============================================================
# AUTO YOUTUBE — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- DEEPSEEK ---
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat          # V3 — fast, cheap, production
DEEPSEEK_R1_MODEL=deepseek-reasoner   # R1 — strategic decisions only

# --- YOUTUBE DATA API ---
# Create a project at: https://console.cloud.google.com
# Enable "YouTube Data API v3", then create an API Key under Credentials.
YOUTUBE_API_KEY=your-youtube-api-key-here

# --- TTS PROVIDER (choose ONE) ---
# Option A: Google Cloud TTS — FREE up to 1M chars/month (recommended)
#   1. Enable "Cloud Text-to-Speech API" in your Google Cloud project
#   2. Create a Service Account, download the JSON key
#   3. Save it as config/google_credentials.json
TTS_PROVIDER=google
GOOGLE_APPLICATION_CREDENTIALS=config/google_credentials.json

# Option B: OpenAI TTS — easier setup, ~$15/1M chars (paid)
# TTS_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=onyx   # options: alloy, echo, fable, onyx, nova, shimmer

# --- PEXELS (stock footage) ---
# Free API key at: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# --- TELEGRAM NOTIFICATIONS (optional but highly recommended) ---
# 1. Create a bot: message @BotFather on Telegram
# 2. Get your chat ID: message @userinfobot
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# --- SYSTEM ---
OUTPUT_DIR=output
LOGS_DIR=logs
