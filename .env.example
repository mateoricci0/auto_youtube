# ============================================================
# AUTO YOUTUBE — TechHoy
# Copia este fichero a .env y rellena los valores marcados con ←
# ============================================================

# --- DEEPSEEK ---
DEEPSEEK_API_KEY=←_PEGA_TU_DEEPSEEK_API_KEY_AQUI
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_R1_MODEL=deepseek-reasoner

# --- YOUTUBE DATA API ---
# ⚠️  Crea una clave NUEVA en console.cloud.google.com → Credenciales
# (la anterior fue compartida en el chat y hay que regenerarla)
YOUTUBE_API_KEY=←_PEGA_TU_NUEVA_YOUTUBE_API_KEY_AQUI

# --- TTS (listo, no necesita configuración) ---
TTS_PROVIDER=gtts

# --- PEXELS ---
# ⚠️  Regenera la clave en pexels.com/api (la anterior fue compartida en el chat)
PEXELS_API_KEY=←_PEGA_TU_NUEVA_PEXELS_API_KEY_AQUI

# --- NOTIFICACIONES POR EMAIL ---
# Pasos rápidos:
#   1. myaccount.google.com → Seguridad → Verificación en 2 pasos (actívala)
#   2. myaccount.google.com → Seguridad → Contraseñas de aplicaciones
#   3. Nombre: "TechHoy Bot" → copia los 16 caracteres SIN espacios
NOTIFY_EMAIL_FROM=←_TU_GMAIL_AQUI
NOTIFY_EMAIL_TO=←_TU_GMAIL_AQUI
NOTIFY_EMAIL_PASSWORD=←_CONTRASEÑA_DE_APLICACION_16_CARACTERES

# --- SISTEMA (no tocar) ---
OUTPUT_DIR=output
LOGS_DIR=logs
